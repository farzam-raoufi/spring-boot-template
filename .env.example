# ----- PostgresSQL -----
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ----- JWT -----
# REQUIRED - Base64-encoded, at least 256 bits. Generate with:
#   openssl rand -base64 32
APP_JWT_SECRET=

# ----- Google OAuth2 -----
# REQUIRED - Web client ID from Google Cloud Console (this is a public value, not a secret)
GOOGLE_CLIENT_ID=

# ----- Optional -----
APP_PORT=8080
DB_PORT=5432
# Must be >= <java.version> in pom.xml
JAVA_VERSION=21
